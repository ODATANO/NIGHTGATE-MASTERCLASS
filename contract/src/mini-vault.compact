// Mini attestation vault.
// attest:     commit to a record with four private values.
// proveField: prove a statement about one value without revealing it.

pragma language_version >= 0.20;

import CompactStandardLibrary;

// Ledger: everything here is public

// One attestation per record id: who attested, and the commitment to the values.
struct Attestation {
  owner:      Bytes<32>,
  commitment: Bytes<32>
}

// A proven statement: value[field_index] <= threshold (op 0) or >= threshold (op 1).
struct Claim {
  record_id:   Bytes<32>,
  field_index: Uint<8>,
  op:          Uint<8>,
  threshold:   Uint<64>
}

export ledger attestations: Map<Bytes<32>, Attestation>;
export ledger claims:       Map<Bytes<32>, Claim>;
export ledger attested:     Counter;

// Hashed structs: each carries its own tag as the first field
struct RecordOpening {
  tag:  Uint<8>,
  v0:   Uint<64>,
  v1:   Uint<64>,
  v2:   Uint<64>,
  v3:   Uint<64>,
  salt: Bytes<32>
}

struct ClaimKey {
  tag:         Uint<8>,
  record_id:   Bytes<32>,
  commitment:  Bytes<32>,
  field_index: Uint<8>,
  op:          Uint<8>,
  threshold:   Uint<64>
}

// Witnesses: private inputs, they never leave the caller's machine 

witness local_secret_key(): Bytes<32>;
witness record_values(record_id: Bytes<32>): Vector<4, Uint<64>>;
witness record_salt(record_id: Bytes<32>): Bytes<32>;

// Pure circuits: the same hashes off-chain and in the proof 

// The public identity of a secret. One-way, so the secret stays private.
export pure circuit ownerIdOf(secret: Bytes<32>): Bytes<32> {
  return upgradeFromTransient(transientHash<Bytes<32>>(secret));
}

// The commitment that goes on the chain instead of the values.
export pure circuit commitmentOf(values: Vector<4, Uint<64>>, salt: Bytes<32>): Bytes<32> {
  return upgradeFromTransient(transientHash<RecordOpening>(RecordOpening {
    tag:  1,
    v0:   values[0],
    v1:   values[1],
    v2:   values[2],
    v3:   values[3],
    salt: salt
  }));
}

// Where a proven statement is stored. A verifier recomputes this key.
export pure circuit claimKeyOf(
  record_id:   Bytes<32>,
  commitment:  Bytes<32>,
  field_index: Uint<8>,
  op:          Uint<8>,
  threshold:   Uint<64>
): Bytes<32> {
  return upgradeFromTransient(transientHash<ClaimKey>(ClaimKey {
    tag:         2,
    record_id:   record_id,
    commitment:  commitment,
    field_index: field_index,
    op:          op,
    threshold:   threshold
  }));
}

pure circuit pick(values: Vector<4, Uint<64>>, field_index: Uint<8>): Uint<64> {
  if (field_index == 0) {
    return values[0];
  }
  if (field_index == 1) {
    return values[1];
  }
  if (field_index == 2) {
    return values[2];
  }
  return values[3];
}

circuit caller_id(): Bytes<32> {
  return ownerIdOf(local_secret_key());
}

// Circuits: functions that define the logic for proofs

// Records the caller's commitment to a record. The values stay private.
export circuit attest(record_id: Bytes<32>): [] {
  const id = disclose(record_id);
  assert(!attestations.member(id), "record already attested");
  const commitment = commitmentOf(record_values(record_id), record_salt(record_id));
  attestations.insert(id, Attestation {
    owner:      disclose(caller_id()),
    commitment: disclose(commitment)
  });
  attested.increment(1);
}

// Proves that one value of an attested record meets a threshold. The proof
// opens the commitment in private. Only the statement goes on the chain.
export circuit proveField(
  record_id:   Bytes<32>,
  field_index: Uint<8>,
  op:          Uint<8>,
  threshold:   Uint<64>
): [] {
  const id = disclose(record_id);
  assert(attestations.member(id), "no attestation for this record");
  const attestation = attestations.lookup(id);
  assert(attestation.owner == caller_id(), "only the attester can prove");
  assert(field_index <= 3, "field index out of range");
  assert(op <= 1, "op out of range");
  const values = record_values(record_id);
  assert(commitmentOf(values, record_salt(record_id)) == attestation.commitment, "values do not match the attestation");
  const value = pick(values, field_index);
  if (op == 0) {
    assert(value <= threshold, "statement is false");
  } else {
    assert(value >= threshold, "statement is false");
  }
  const key = claimKeyOf(record_id, attestation.commitment, field_index, op, threshold);
  claims.insert(disclose(key), Claim {
    record_id:   id,
    field_index: disclose(field_index),
    op:          disclose(op),
    threshold:   disclose(threshold)
  });
}
